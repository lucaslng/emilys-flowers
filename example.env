# Stripe — server only (never expose to the client)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe — client-side (safe to expose; currently unused — reserved for future client-side Stripe SDK)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend — transactional email (server only; send-only API key)
RESEND_API_KEY=re_xxx

# Stripe webhook signing secret (server only; from `stripe listen` locally or the Stripe dashboard in prod)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# OIDC admin auth for /admin/orders (server only; authorization code + PKCE)
OIDC_ISSUER=https://accounts.example.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret
# HS256 signing key for the admin session JWT (>= 32 chars; openssl rand -base64 32)
ADMIN_SESSION_SECRET=replace-with-openssl-rand-base64-32-output
# Comma-separated groups allowed to access /admin/orders (provider must return a `groups` claim)
ADMIN_OIDC_GROUPS=emilys-flowers-admins
# Required in production (never derived from the Host header); optional in dev (falls back to the request origin).
# The OIDC callback URL is derived as BASE_URL + /api/admin/callback
# BASE_URL=https://emilysflowers.ca