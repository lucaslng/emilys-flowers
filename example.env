# Stripe — server only (never expose to the client)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe — client-side (safe to expose; currently unused — reserved for future client-side Stripe SDK)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Payload CMS — server only
PAYLOAD_SECRET=dev-payload-secret-change-me

# Backblaze B2 — S3-compatible storage for Payload media + ISR cache (server only)
# Credentials are secrets (wrangler secret put per Worker); region/buckets are vars.
B2_APPLICATION_KEY_ID=xxx
B2_APPLICATION_KEY=xxx
B2_REGION=us-west-004
B2_MEDIA_BUCKET=emilys-flowers-media
B2_CACHE_BUCKET=emilys-flowers-incremental-cache