# Stripe — server only (never expose to the client)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe — client-side (safe to expose; currently unused — reserved for future client-side Stripe SDK)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Resend — transactional email (server only; send-only API key)
RESEND_API_KEY=re_xxx

# Stripe webhook signing secret (server only; from `stripe listen` locally or the Stripe dashboard in prod)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Admin password for /admin/orders (server only; any non-empty string)
ADMIN_PASSWORD=change-me