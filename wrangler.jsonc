{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "emilys-flowers",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "emilys-flowers"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "D1"
    }
  ],
  "env": {
    "production": {
      "name": "emilys-flowers-production",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "emilys-flowers-production"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      "routes": [{ "pattern": "emilysflowers.ca", "custom_domain": true }],
      "vars": {
        "UNDER_CONSTRUCTION": "true"
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "emilysflowers-live",
          "database_id": "b54e9d99-eea8-4d81-991e-b361b07681b9"
        }
      ]
    },
    "preview": {
      "name": "emilys-flowers-preview",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "emilys-flowers-preview"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "emilysflowers-test",
          "database_id": "c5ec1eb0-d35c-404f-b7ac-d1b575ce0c01"
        }
      ]
    }
  }
}
