{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "emilys-flowers",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "emilys-flowers"
    }
  ],
  // Non-sensitive vars only — secrets (PAYLOAD_SECRET, B2_APPLICATION_KEY_ID,
  // B2_APPLICATION_KEY, UPLOADTHING_TOKEN) are set per Worker via `wrangler secret put`.
  // NOTE: wrangler does NOT inherit `vars` into [env.*] stanzas — each env repeats them.
  "vars": {
    "B2_REGION": "ca-east-006",
    "B2_CACHE_BUCKET": "emilys-flowers-incremental-cache"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "emilys-flowers-payload",
      "database_id": "5346d160-4c6a-40d7-b9f4-d9a9cb5e9259"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "emilys-flowers-tag-cache",
      "database_id": "5e11fd9e-b95a-429e-a90b-09627de58157"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "emilys-flowers-production",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "emilys-flowers-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "emilys-flowers-payload",
          "database_id": "5346d160-4c6a-40d7-b9f4-d9a9cb5e9259"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "emilys-flowers-tag-cache",
          "database_id": "5e11fd9e-b95a-429e-a90b-09627de58157"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      "routes": [{ "pattern": "emilysflowers.ca", "custom_domain": true }],
      "vars": {
        "UNDER_CONSTRUCTION": "true",
        "B2_REGION": "ca-east-006",
        "B2_CACHE_BUCKET": "emilys-flowers-incremental-cache"
      }
    },
    "preview": {
      "name": "emilys-flowers-preview",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "emilys-flowers-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "emilys-flowers-payload",
          "database_id": "5346d160-4c6a-40d7-b9f4-d9a9cb5e9259"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "emilys-flowers-tag-cache",
          "database_id": "5e11fd9e-b95a-429e-a90b-09627de58157"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      "vars": {
        "B2_REGION": "ca-east-006",
        "B2_CACHE_BUCKET": "emilys-flowers-incremental-cache"
      }
    }
  }
}
