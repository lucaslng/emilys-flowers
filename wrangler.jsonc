{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "emilys-flowers",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "emilys-flowers"
    }
  ],
  "vars": {
    "PAYLOAD_SECRET": "dev-payload-secret-change-me"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "emilys-flowers-payload",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    },
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "emilys-flowers-tag-cache",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "emilys-flowers-media"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "emilys-flowers-incremental-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "production": {
      "name": "emilys-flowers-production",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "emilys-flowers-production"
        }
      ],
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "emilys-flowers-payload",
          "database_id": "REPLACE_WITH_DATABASE_ID"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "emilys-flowers-tag-cache",
          "database_id": "REPLACE_WITH_DATABASE_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "emilys-flowers-media"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "emilys-flowers-incremental-cache"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      },
      "routes": [{ "pattern": "emilysflowers.ca", "custom_domain": true }],
      "vars": {
        "UNDER_CONSTRUCTION": "true"
      }
    },
    "preview": {
      "name": "emilys-flowers-preview",
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "emilys-flowers-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "D1",
          "database_name": "emilys-flowers-payload",
          "database_id": "REPLACE_WITH_DATABASE_ID"
        },
        {
          "binding": "NEXT_TAG_CACHE_D1",
          "database_name": "emilys-flowers-tag-cache",
          "database_id": "REPLACE_WITH_DATABASE_ID"
        }
      ],
      "r2_buckets": [
        {
          "binding": "R2",
          "bucket_name": "emilys-flowers-media"
        },
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "emilys-flowers-incremental-cache"
        }
      ],
      "images": {
        "binding": "IMAGES"
      },
      "observability": {
        "enabled": true
      }
    }
  }
}
